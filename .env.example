# Compose-interpolation secrets for the Company-Backend stack.
# Copy to `.env` NEXT TO compose.yml on the server (/home/company/app/.env),
# fill in real values, chmod 600. Never commit the filled file (.env is
# gitignored). docker compose reads this automatically for ${VAR} substitution.

# RabbitMQ credentials (used only inside the stack; delta/bonfire/voice-ingress
# read the same values via Revolt.toml / their own config).
# Generate: openssl rand -hex 24
RABBITMQ_USER=rabbituser
RABBITMQ_PASS=CHANGE_ME

# Admin API key for the signer sidecar service.
# Generate: openssl rand -base64 48
SIGNER_ADMIN_API_KEY=CHANGE_ME

# SMTP password for the signer's outbound mail — this is a Resend API key
# (smtp.resend.com, username "resend"). Get/rotate it in the Resend dashboard,
# do NOT generate locally.
SMTP_PASSWORD=CHANGE_ME

# Optional handshake-HMAC secret for beacon-signal. Empty/unset disables the
# handshake-HMAC layer (per-message Ed25519 JWT auth still applies).
# Generate: openssl rand -base64 48
COMPANY_SIGNAL_SECRET=
